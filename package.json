{
  "name": "web-portfolio-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "generate:blog": "node scripts/generate-blog-content.mjs",
    "generate:indexes": "node scripts/generate-content-indexes.mjs",
    "generate:content": "npm run generate:blog && npm run generate:indexes",
    "predev": "npm run generate:content",
    "prebuild": "npm run generate:content",
    "prestart": "npm run generate:content",
    "prelint": "npm run generate:content",
    "dev": "next dev",
    "build": "next build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "start": "next start",
    "lint": "eslint",
    "test:e2e": "playwright test",
    "check:colors": "sh -c 'if rg -n \"(#[0-9A-Fa-f]{3,8}\\\\b|rgba?\\\\(|hsla?\\\\(|oklch\\\\()\" src --glob \"*.{ts,tsx,js,jsx,css}\" --glob \"!src/constants/colors.ts\" --glob \"!src/app/globals.css\" --glob \"!src/content/**/generated.ts\"; then echo \"Error: literal colors must be defined in src/constants/colors.ts or src/app/globals.css\"; exit 1; fi'"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.1",
    "clsx": "^2.1.1",
    "fast-xml-parser": "^5.7.2",
    "framer-motion": "^12.38.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.14.0",
    "next": "16.2.10",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-icons": "^5.6.0",
    "react-slick": "^0.31.0",
    "rehype-pretty-code": "^0.14.3",
    "rehype-stringify": "^10.0.1",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.0.2",
    "slick-carousel": "^1.8.1",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19",
    "@types/react-slick": "^0.23.13",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.111.0"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.19"
    }
  }
}
